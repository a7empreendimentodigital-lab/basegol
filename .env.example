# Database
DATABASE_URL="mysql://user:password@localhost:3306/basegol"

# NextAuth
# Deve usar a mesma porta do `npm run dev` (padrão 3000)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# URL pública do site (favicon/PWA no celular em produção)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Produção (Vercel): NEXTAUTH_URL = URL pública do app (https://...)
# Banco (Railway): DATABASE_URL = mysql://...
# Após importar o banco: npm run db:ensure-master

# Upload — escolha UM modo:
# Vercel Blob (produção Vercel):
BLOB_READ_WRITE_TOKEN=""
# VPS Ubuntu / servidor próprio (grava em public/uploads):
UPLOAD_STORAGE=local
# Opcional: diretório customizado (padrão: ./public/uploads)
# UPLOAD_DIR="/var/www/basegol/public/uploads"
