generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Auth & Users ───────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
  BANNED
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  emailVerified DateTime?
  passwordHash  String?
  mustChangePassword Boolean @default(true)
  name          String?
  image         String?
  phone         String?
  status        UserStatus @default(ACTIVE)
  roleId        String
  role          Role       @relation(fields: [roleId], references: [id])
  clubUsers     ClubUser[]
  favorites     Favorite[]
  settings      Setting[]
  auditLogs     AuditLog[]
  accounts      Account[]
  sessions      Session[]
  passwordResetTokens PasswordResetToken[]
  matchOperators MatchOperator[]
  notifications Notification[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([roleId])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  permissions Json     @default("[]")
  rolePermissions RolePermission[]
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  group       String?
  roles       RolePermission[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Clubs & Staff ──────────────────────────────────────────────

enum ClubStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model Club {
  id             String         @id @default(cuid())
  name           String
  normalizedName String         @unique
  slug           String         @unique
  shortName      String?
  crestUrl       String?
  bannerUrl      String?
  city           String?
  state          String         @default("SP")
  foundedYear    Int?
  description    String?        @db.Text
  status         ClubStatus     @default(PENDING)
  athletes       Athlete[]
  staffMembers   StaffMember[]
  clubUsers      ClubUser[]
  teams          Team[]
  registrations  Registration[]
  documents      Document[]
  homeMatches    Match[]        @relation("MatchHomeClub")
  awayMatches    Match[]        @relation("MatchAwayClub")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([name])
  @@map("clubs")
}

enum ClubUserRole {
  OWNER
  MANAGER
  COACH
  STAFF
}

model ClubUser {
  id        String       @id @default(cuid())
  userId    String
  clubId    String
  role      ClubUserRole @default(MANAGER)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  club      Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([userId, clubId])
  @@index([clubId])
  @@map("club_users")
}

enum AthleteStatus {
  ACTIVE
  INJURED
  SUSPENDED
  INACTIVE
  PENDING_DOCS
}

enum PlayerPosition {
  GK
  CB
  LB
  RB
  CDM
  CM
  CAM
  LW
  RW
  ST
  CF
}

model Athlete {
  id           String         @id @default(cuid())
  clubId       String
  firstName    String
  lastName     String
  slug         String         @unique
  photoUrl     String?
  birthDate    DateTime
  heightCm     Int?
  weightKg     Float?
  position     PlayerPosition
  shirtNumber  Int?
  category     String?
  status       AthleteStatus  @default(ACTIVE)
  bio          String?        @db.Text
  club         Club           @relation(fields: [clubId], references: [id], onDelete: Cascade)
  documents    Document[]
  lineups      Lineup[]
  matchEvents  MatchEvent[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([clubId])
  @@map("athletes")
}

enum StaffRole {
  HEAD_COACH
  ASSISTANT_COACH
  GOALKEEPER_COACH
  PHYSIO
  ANALYST
  MANAGER
}

model StaffMember {
  id        String      @id @default(cuid())
  clubId    String
  name      String
  role      StaffRole
  photoUrl  String?
  phone     String?
  email     String?
  license   String?
  status    StaffStatus @default(ACTIVE)
  club      Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([clubId])
  @@map("staff_members")
}

// ─── Championships ──────────────────────────────────────────────

enum ChampionshipStatus {
  DRAFT
  REGISTRATION
  ACTIVE
  FINISHED
  CANCELLED
}

model Championship {
  id              String             @id @default(cuid())
  name            String
  slug            String             @unique
  description     String?            @db.Text
  season          String
  logoUrl         String?
  bannerUrl       String?
  status          ChampionshipStatus @default(DRAFT)
  startDate       DateTime?
  endDate         DateTime?
  seasons         Season[]
  categories      Category[]
  news            News[]
  registrations   Registration[]
  phases          CompetitionPhase[]
  rounds          CompetitionRound[]
  matches         Match[]
  scheduleImports ScheduleImport[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@map("championships")
}

model Season {
  id             String       @id @default(cuid())
  championshipId String
  name           String
  year           Int
  isCurrent      Boolean      @default(false)
  championship   Championship @relation(fields: [championshipId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([championshipId])
  @@map("seasons")
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum GroupStatus {
  ACTIVE
  INACTIVE
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

model Category {
  id              String           @id @default(cuid())
  championshipId  String
  name            String
  slug            String
  imageUrl        String?
  ageGroup        String?
  minAge          Int?
  maxAge          Int?
  gender          String?
  status          CategoryStatus   @default(ACTIVE)
  championship    Championship     @relation(fields: [championshipId], references: [id], onDelete: Cascade)
  groups          Group[]
  standings       Standing[]
  scheduleImports ScheduleImport[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([championshipId, slug])
  @@map("categories")
}

model Group {
  id         String      @id @default(cuid())
  categoryId String
  name       String
  slug       String
  status     GroupStatus @default(ACTIVE)
  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  teams      Team[]
  matches    Match[]
  standing   Standing?
  createdAt  DateTime    @default(now())

  @@unique([categoryId, slug])
  @@unique([categoryId, name])
  @@map("groups")
}

model Team {
  id        String   @id @default(cuid())
  clubId    String
  groupId   String
  name      String?
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  homeMatches Match[] @relation("HomeTeam")
  awayMatches Match[] @relation("AwayTeam")
  standingRows StandingRow[]
  lineups   Lineup[]
  createdAt DateTime @default(now())

  @@unique([clubId, groupId])
  @@index([groupId])
  @@map("teams")
}

// ─── Competition structure (importação FP) ─────────────────────

model Venue {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique
  city           String?
  state          String?  @default("SP")
  matches        Match[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("venues")
}

model CompetitionPhase {
  id             String           @id @default(cuid())
  championshipId String
  name           String
  slug           String
  championship   Championship     @relation(fields: [championshipId], references: [id], onDelete: Cascade)
  turns          CompetitionTurn[]
  rounds         CompetitionRound[]
  matches        Match[]
  createdAt      DateTime         @default(now())

  @@unique([championshipId, slug])
  @@unique([championshipId, name])
  @@map("competition_phases")
}

model CompetitionTurn {
  id        String           @id @default(cuid())
  phaseId   String
  name      String
  slug      String
  phase     CompetitionPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  rounds    CompetitionRound[]
  matches   Match[]
  createdAt DateTime         @default(now())

  @@unique([phaseId, slug])
  @@unique([phaseId, name])
  @@map("competition_turns")
}

model CompetitionRound {
  id             String            @id @default(cuid())
  championshipId String
  phaseId        String
  turnId         String
  number         Int
  label          String?
  championship   Championship      @relation(fields: [championshipId], references: [id], onDelete: Cascade)
  phase          CompetitionPhase  @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  turn           CompetitionTurn   @relation(fields: [turnId], references: [id], onDelete: Cascade)
  matches        Match[]
  createdAt      DateTime          @default(now())

  @@unique([championshipId, phaseId, turnId, number])
  @@map("competition_rounds")
}

enum ScheduleImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ScheduleImportLogLevel {
  INFO
  WARN
  ERROR
}

model ScheduleImport {
  id             String               @id @default(cuid())
  championshipId String
  categoryId     String?
  fileName       String
  status         ScheduleImportStatus @default(PENDING)
  summary        Json?
  createdById    String?
  championship   Championship         @relation(fields: [championshipId], references: [id], onDelete: Cascade)
  category       Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  logs           ScheduleImportLog[]
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime             @default(now())

  @@index([championshipId])
  @@map("schedule_imports")
}

model ScheduleImportLog {
  id        String                 @id @default(cuid())
  importId  String
  level     ScheduleImportLogLevel @default(INFO)
  code      String?
  message   String                 @db.Text
  metadata  Json?
  import    ScheduleImport         @relation(fields: [importId], references: [id], onDelete: Cascade)
  createdAt DateTime               @default(now())

  @@index([importId])
  @@map("schedule_import_logs")
}

// ─── Matches ────────────────────────────────────────────────────

enum MatchStatus {
  SCHEDULED
  LIVE
  HALFTIME
  FINISHED
  POSTPONED
  CANCELLED
}

enum MatchPeriod {
  SCHEDULED
  FIRST_HALF
  HALFTIME
  SECOND_HALF
  THIRD_HALF
  PENALTY_SHOOTOUT
  FINISHED
}

model Match {
  id                 String            @id @default(cuid())
  championshipId     String?
  groupId            String
  homeTeamId         String
  awayTeamId         String
  homeClubId         String?
  awayClubId         String?
  phaseId            String?
  turnId             String?
  competitionRoundId String?
  matchNumber        Int?
  round              Int               @default(1)
  scheduledAt        DateTime
  venue              String?
  venueId            String?
  importFingerprint  String?           @unique
  sumulaMeta         Json?
  status             MatchStatus       @default(SCHEDULED)
  matchPeriod        MatchPeriod       @default(SCHEDULED)
  homeScore          Int               @default(0)
  awayScore          Int               @default(0)
  homePenaltyScore   Int               @default(0)
  awayPenaltyScore   Int               @default(0)
  minute             Int?
  extraTime          Int?
  elapsedSeconds            Int               @default(0)
  accumulatedPeriodSeconds  Int               @default(0)
  clockRunning              Boolean           @default(false)
  clockStartedAt     DateTime?
  periodLengthMin    Int               @default(17)
  periodCount        Int               @default(3)
  championship       Championship?     @relation(fields: [championshipId], references: [id], onDelete: SetNull)
  group              Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  homeTeam           Team              @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam           Team              @relation("AwayTeam", fields: [awayTeamId], references: [id])
  homeClub           Club?             @relation("MatchHomeClub", fields: [homeClubId], references: [id], onDelete: SetNull)
  awayClub           Club?             @relation("MatchAwayClub", fields: [awayClubId], references: [id], onDelete: SetNull)
  phase              CompetitionPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  turn               CompetitionTurn?  @relation(fields: [turnId], references: [id], onDelete: SetNull)
  competitionRound   CompetitionRound? @relation(fields: [competitionRoundId], references: [id], onDelete: SetNull)
  venueRef           Venue?            @relation(fields: [venueId], references: [id], onDelete: SetNull)
  events             MatchEvent[]
  statistics         MatchStatistic?
  lineups            Lineup[]
  operators          MatchOperator[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([groupId])
  @@index([championshipId])
  @@index([phaseId])
  @@index([status])
  @@index([scheduledAt])
  @@index([homeClubId, awayClubId])
  @@map("matches")
}

model MatchOperator {
  id          String   @id @default(cuid())
  matchId     String
  userId      String
  canEditLive Boolean  @default(true)
  canEditStats Boolean @default(true)
  assignedBy  String?
  assignedAt  DateTime @default(now())
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@index([userId])
  @@map("match_operators")
}

enum MatchEventType {
  GOAL
  OWN_GOAL
  PENALTY_GOAL
  PENALTY_MISS
  YELLOW_CARD
  RED_CARD
  SUBSTITUTION
  VAR
  HALFTIME
  FULLTIME
  KICKOFF
}

model MatchEvent {
  id          String         @id @default(cuid())
  matchId     String
  type        MatchEventType
  minute      Int
  extraMinute Int?
  teamId      String?
  athleteId   String?
  description String?
  match       Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  athlete     Athlete?       @relation(fields: [athleteId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())

  @@index([matchId])
  @@map("match_events")
}

model MatchStatistic {
  id              String @id @default(cuid())
  matchId         String @unique
  homePossession  Int    @default(50)
  awayPossession  Int    @default(50)
  homeShots       Int    @default(0)
  awayShots       Int    @default(0)
  homeShotsOnGoal Int    @default(0)
  awayShotsOnGoal Int    @default(0)
  homeCorners     Int    @default(0)
  awayCorners     Int    @default(0)
  homeFouls       Int    @default(0)
  awayFouls       Int    @default(0)
  homeOffsides    Int    @default(0)
  awayOffsides    Int    @default(0)
  homeYellowCards Int    @default(0)
  awayYellowCards Int    @default(0)
  homeRedCards    Int    @default(0)
  awayRedCards    Int    @default(0)
  match           Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@map("match_statistics")
}

enum LineupRole {
  STARTER
  SUBSTITUTE
}

model Lineup {
  id        String     @id @default(cuid())
  matchId   String
  teamId    String
  athleteId String
  role      LineupRole @default(STARTER)
  position  PlayerPosition?
  shirtNumber Int?
  match     Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team      Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  athlete   Athlete    @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([matchId, teamId, athleteId])
  @@index([matchId])
  @@map("lineups")
}

// ─── Standings ───────────────────────────────────────────────────

model Standing {
  id         String        @id @default(cuid())
  categoryId String
  groupId    String?       @unique
  name       String?
  category   Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  group      Group?        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  rows       StandingRow[]
  updatedAt  DateTime      @updatedAt

  @@index([categoryId])
  @@map("standings")
}

model StandingRow {
  id          String   @id @default(cuid())
  standingId  String
  teamId      String
  position    Int      @default(0)
  played      Int      @default(0)
  won         Int      @default(0)
  drawn       Int      @default(0)
  lost        Int      @default(0)
  goalsFor    Int      @default(0)
  goalsAgainst Int     @default(0)
  points      Int      @default(0)
  form        String?
  standing    Standing @relation(fields: [standingId], references: [id], onDelete: Cascade)
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([standingId, teamId])
  @@index([standingId])
  @@map("standing_rows")
}

// ─── Registrations & Documents ───────────────────────────────────

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

model Registration {
  id             String             @id @default(cuid())
  clubId         String
  championshipId String
  categoryId     String?
  status         RegistrationStatus @default(PENDING)
  notes          String?            @db.Text
  club           Club               @relation(fields: [clubId], references: [id], onDelete: Cascade)
  championship   Championship       @relation(fields: [championshipId], references: [id], onDelete: Cascade)
  documents      Document[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([clubId, championshipId])
  @@map("registrations")
}

enum DocumentType {
  IDENTITY
  MEDICAL
  AUTHORIZATION
  REGISTRATION_FORM
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

model Document {
  id             String         @id @default(cuid())
  clubId         String?
  athleteId      String?
  registrationId String?
  type           DocumentType
  status         DocumentStatus @default(PENDING)
  fileUrl        String
  fileName       String?
  expiresAt      DateTime?
  club           Club?          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  athlete        Athlete?       @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  registration   Registration?  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([clubId])
  @@index([athleteId])
  @@map("documents")
}

// ─── Content ─────────────────────────────────────────────────────

model News {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  summary        String?       @db.Text
  content        String        @db.Text
  imageUrl       String?
  category       String?
  isFeatured     Boolean       @default(false)
  publishedAt    DateTime?
  championshipId String?
  championship   Championship? @relation(fields: [championshipId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([publishedAt])
  @@map("news")
}

enum BannerPlacement {
  HERO_CAROUSEL
  SIDEBAR_LEFT
  SIDEBAR_RIGHT
}

model Banner {
  id        String          @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String
  linkUrl   String?
  placement BannerPlacement @default(HERO_CAROUSEL)
  order     Int             @default(0)
  isActive  Boolean         @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([placement, isActive, order])
  @@map("banners")
}

// ─── User extras ─────────────────────────────────────────────────

enum FavoriteType {
  CLUB
  MATCH
  CHAMPIONSHIP
  ATHLETE
}

model Favorite {
  id        String       @id @default(cuid())
  userId    String
  type      FavoriteType
  entityId  String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([userId, type, entityId])
  @@map("favorites")
}

model Setting {
  id        String   @id @default(cuid())
  userId    String
  key       String
  value     Json
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@map("settings")
}

enum NotificationType {
  MATCH
  NEWS
  REGISTRATION
  DOCUMENT
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?          @db.Text
  linkUrl   String?
  isRead    Boolean          @default(false)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  impersonatedUserId String?
  metadata  Json?
  ipAddress String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique @db.VarChar(191)
  expiresAt DateTime
  usedAt    DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model ThemeConfig {
  id             String   @id @default(cuid())
  name           String   @default("default")
  isActive       Boolean  @default(true)
  primaryColor   String   @default("#39ff14")
  secondaryColor String   @default("#00c853")
  backgroundColor String  @default("#050505")
  cardColor      String   @default("#0f0f13")
  textPrimary    String   @default("#ffffff")
  textSecondary  String   @default("#9ca3af")
  borderColor    String   @default("rgba(57,255,20,0.15)")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("theme_configs")
}

model BrandConfig {
  id               String   @id @default(cuid())
  systemName       String   @default("BASEGOL")
  slogan           String?
  logoUrl          String?
  mobileLogoUrl    String?
  faviconUrl       String?
  splashScreenUrl  String?
  loginBackgroundUrl String?
  homeHeroBackgroundUrl String?
  updatedBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("brand_configs")
}

model Sponsor {
  id          String   @id @default(cuid())
  name        String
  logoUrl     String?
  websiteUrl  String?
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("sponsors")
}

model SiteSection {
  id          String   @id @default(cuid())
  key         String   @unique
  title       String?
  subtitle    String?
  content     Json?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("site_sections")
}

model SiteText {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  locale      String   @default("pt-BR")
  context     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("site_texts")
}

model MenuItem {
  id          String   @id @default(cuid())
  label       String
  href        String
  icon        String?
  area        String   @default("PUBLIC")
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([area, isActive])
  @@map("menu_items")
}

enum MediaType {
  IMAGE
  DOCUMENT
  VIDEO
}

model MediaAsset {
  id          String    @id @default(cuid())
  type        MediaType @default(IMAGE)
  category    String?
  title       String?
  originalName String?
  mimeType    String?
  url         String
  sizeBytes   Int?
  uploadedBy  String?
  createdAt   DateTime  @default(now())

  @@index([type, category])
  @@map("media_assets")
}
